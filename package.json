{
  "name": "baawaray-post-production-studio",
  "version": "2.0.0",
  "description": "Baawaray Films • Unified Post-Production Powerhouse Studio (Admin, Photo Editor & Video Editor)",
  "main": "./out/main/index.js",
  "author": "Baawaray Films",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:admin": "electron-vite dev -- --profile=admin",
    "dev:photo": "electron-vite dev -- --profile=photo",
    "dev:video": "electron-vite dev -- --profile=video",
    "start": "electron ./out/main/index.js",
    "start:admin": "electron ./out/main/index.js --profile=admin",
    "start:photo": "electron ./out/main/index.js --profile=photo",
    "start:video": "electron ./out/main/index.js --profile=video",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dropbox": "^10.46.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "^12.18.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^178.1.1",
    "lucide-react": "^1.43.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
